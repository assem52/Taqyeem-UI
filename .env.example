# API origin (required for production builds)
VITE_API_BASE_URL=http://localhost:3000

# Optional DEV-only header fallbacks — prefer logging in at /login.
# Seed student UUID from backend `npx prisma db seed` (see backend README).
# VITE_MOCK_STUDENT_ID=

# Must match backend ADMIN_API_TOKEN if you use the header fallback.
# Local development only — never set this in a deployed build.
# VITE_ADMIN_TOKEN=
